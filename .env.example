# Zorin VM Automation — Configuration Template
# Copy this file to .env and configure the variables accordingly.

# JWT Authentication (Required: Must be a secure random hex key of at least 64 characters)
SECRET_KEY=your-secure-random-64-character-hex-key-here

# Database Settings
DATABASE_URL=sqlite:///./zorin_vm_platform.db
LOGIN_RATE_LIMIT=5/15minute
LOG_LEVEL=INFO
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5



# VirtualBox Paths & Configurations
VBOXMANAGE_PATH=C:\Program Files\Oracle\VirtualBox\VBoxManage.exe
VM_BASE_DIR=C:\VMs\vms
GOLDEN_MASTER_DIR=C:\VMs\golden-masters
CLOUD_INIT_TEMP=C:\VMs\cloud-init-temp
VM_START_TYPE=headless  # Use "gui" to open VirtualBox window, or "headless" for background run

# VM Provisioning Defaults
DEFAULT_VCPU=1
DEFAULT_RAM_MB=1024
DEFAULT_DISK_GB=15

# SMTP / Email Verification
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@zorinvm.local
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_SIMULATION_MODE=true  # Set to false to send real emails via SMTP
APP_BASE_URL=http://localhost:8000
